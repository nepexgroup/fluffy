{
  "name": "@fluffy/theme",
  "version": "0.1.0",
  "description": "Fluffy design tokens, Tailwind preset and base styles (frappe-ui style)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/preset.js",
  "types": "./dist/preset.d.ts",
  "exports": {
    ".": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/tokens.css src/base.css dist/ && tailwindcss -c tailwind.build.js -i src/style.css -o dist/style.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.9"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
