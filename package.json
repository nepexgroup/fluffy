{
  "name": "fluffy",
  "version": "0.1.0",
  "private": true,
  "description": "Fluffy — a frappe-ui-style component library for Vue 3 and React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nepexgroup/fluffy.git"
  },
  "author": "Sandesh Rana (vimm0)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "typecheck": "pnpm --filter \"./packages/*\" -r typecheck",
    "storybook": "pnpm --filter \"./apps/*\" --parallel -r storybook",
    "build-storybook": "pnpm --filter \"./apps/*\" -r build-storybook"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
